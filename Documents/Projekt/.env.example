# ============================================================
#  .env  –  Konfiguration für das Kanzlei-Backend
#  Umbenennen in ".env" und Werte eintragen!
# ============================================================

# ── Anthropic API (für PDF-KI-Extraktion via Cloud) ─────────
# Erhältlich unter https://console.anthropic.com
# DSGVO: Bitte Data Processing Agreement (DPA) abschließen!
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ── Kanzlei-Stammdaten ──────────────────────────────────────
KANZLEI_NAME=Rechtsanwalt Max Mustermann
KANZLEI_STRASSE=Musterstraße 1
KANZLEI_PLZ_ORT=12345 Musterstadt
KANZLEI_TEL=0123 456789-0
KANZLEI_EMAIL=kanzlei@mustermann-recht.de
KANZLEI_IBAN=DE12 3456 7890 1234 5678 90
KANZLEI_BIC=MUSTDE12XXX

# ── Datenbank ───────────────────────────────────────────────
# Standard: SQLite (Datei im Backend-Ordner)
# Für PostgreSQL: postgresql://user:pass@localhost:5432/kanzlei
DATABASE_URL=sqlite:///./kanzlei.db
