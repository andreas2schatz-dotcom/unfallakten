# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.example
# Kopieren nach .env.development (lokal) oder .env.production (Server)
#
# WICHTIG: VITE_* Variablen werden zur Build-Zeit ins Bundle eingebettet.
#          Niemals Passwörter oder Secrets hier eintragen!
# ─────────────────────────────────────────────────────────────────────────────

# Backend-URL: Im Dev-Modus nutzt vite.config.js Proxy, daher leer lassen.
# Im Prod-Build: vollständige URL zum Backend ODER leer lassen wenn Frontend
# und Backend auf gleicher Domain laufen (nginx routed /auth /akten intern).
VITE_API_URL=

# Demo-Modus: true = kein echtes Backend nötig, Mock-Daten werden verwendet.
# Im Produktions-Build immer auf false setzen.
VITE_DEMO_MODE=false

# App-Titel (optional, für Browser-Tab und SEO)
VITE_APP_TITEL=Unfallakten – Koch, Schatz & Kollegen
