# =============================================================================
#  Unfallakten-System – Konfigurationsdatei
#  Koch, Schatz & Kollegen · Rechtsanwaltskanzlei Offenbach
# =============================================================================
#
#  ANLEITUNG:
#  1. Diese Datei kopieren:  cp .env.example .env
#  2. Alle Werte mit BITTE_ERSETZEN ausfüllen
#  3. Datei speichern
#  4. docker compose up --build
#
#  WICHTIG: Die .env-Datei NIEMALS in Git einchecken!
#           Sie enthält Passwörter und geheime Schlüssel.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  SICHERHEIT  (Pflichtfelder – müssen ausgefüllt werden)
# -----------------------------------------------------------------------------

# Geheimer Schlüssel für JWT-Tokens (Anmeldung/Sessions).
# Muss mindestens 32 zufällige Zeichen lang sein.
# Schlüssel generieren mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=BITTE_ERSETZEN

# Zweiter geheimer Schlüssel für Flask (darf nicht identisch mit JWT_SECRET_KEY sein).
# Gleiches Verfahren zum Generieren wie oben.
FLASK_SECRET_KEY=BITTE_ERSETZEN


# -----------------------------------------------------------------------------
#  SERVER
# -----------------------------------------------------------------------------

# Erlaubte Herkunft für API-Anfragen (CORS).
#
#   Lokale Entwicklung ohne Docker:   http://localhost:5173
#   Lokale Entwicklung mit Docker:    http://localhost:5173
#   Produktionsserver:                https://anwalt-offenbach.de
#
CORS_ORIGIN=http://localhost:5173

# Protokoll-Detailgrad: DEBUG | INFO | WARNING | ERROR
# Für Produktion empfohlen: INFO
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  DATENBANK & DATEIEN
# -----------------------------------------------------------------------------

# Speicherort der SQLite-Datenbank (innerhalb des Docker-Containers).
# Nicht ändern, außer der Container-Pfad wurde angepasst.
DB_PATH=/app/data/unfallakten.db

# Speicherort für hochgeladene PDF-Dokumente (innerhalb des Containers).
UPLOAD_DIR=/app/uploads

# Maximale Dateigröße für Uploads in Bytes.
# 20971520 = 20 MB  |  10485760 = 10 MB  |  52428800 = 50 MB
MAX_UPLOAD_BYTES=20971520


# -----------------------------------------------------------------------------
#  ANMELDE-TOKENS
# -----------------------------------------------------------------------------

# Wie lange ein Anmelde-Token gültig bleibt (in Minuten).
# Nach Ablauf muss der Benutzer sich neu anmelden oder der Token wird
# automatisch per Refresh-Token erneuert.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Wie lange der Refresh-Token gültig bleibt (in Tagen).
# Nach Ablauf ist eine erneute Anmeldung erforderlich.
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
#  KANZLEI-STAMMDATEN  (erscheinen in generierten Word-Dokumenten)
# -----------------------------------------------------------------------------

KANZLEI_NAME=Rechtsanwaltskanzlei Koch, Schatz & Kollegen
KANZLEI_STRASSE=Frankfurter Straße 12
KANZLEI_ORT=63065 Offenbach am Main
KANZLEI_TEL=069 / 83 10 99 - 0
KANZLEI_FAX=069 / 83 10 99 - 99
KANZLEI_EMAIL=info@anwalt-offenbach.de
KANZLEI_WEB=www.anwalt-offenbach.de


# -----------------------------------------------------------------------------
#  INITIALER ADMIN  (nur beim ersten App-Start relevant)
# -----------------------------------------------------------------------------

# Admin 1 (Koch) – wird beim ersten Start angelegt wenn keine Benutzer vorhanden
ADMIN_EMAIL=koch@anwalt-offenbach.de
ADMIN_PASSWORT=Kanzlei2024!
ADMIN_NAME=Peter Koch

# Admin 2 (Schatz)
ADMIN_PASSWORT_2=As155255


# -----------------------------------------------------------------------------
#  E-MAIL-IMPORT  (optional – nur ausfüllen wenn E-Mail-Import genutzt wird)
# -----------------------------------------------------------------------------

# IMAP-Server Ihres E-Mail-Postfachs (z.B. mail.anwalt-offenbach.de)
# EMAIL_HOST=

# IMAP-Port: 993 = mit SSL (empfohlen)  |  143 = ohne SSL
# EMAIL_PORT=993

# E-Mail-Adresse des Postfachs
# EMAIL_USER=

# Passwort des Postfachs
# EMAIL_PASSWORD=BITTE_ERSETZEN

# Ordner der überwacht werden soll (meistens INBOX)
# EMAIL_FOLDER=INBOX

# Maximale Anzahl E-Mails pro Import-Durchlauf
# EMAIL_MAX_FETCH=50

# -----------------------------------------------------------------------------
#  IMAP AUTO-POLLING  (US-02 – pro Account eigenes Passwort)
# -----------------------------------------------------------------------------
# Gemeinsamer Server für alle Accounts: EMAIL_HOST + EMAIL_PORT (oben).
# Pro Account: eigene Adresse + eigenes Passwort.
# Fehlt ein Eintrag, wird das Polling für diesen Account automatisch deaktiviert.

# EMAIL_USER_UNFALL=unfall@anwalt-offenbach.de
# EMAIL_PASSWORD_UNFALL=BITTE_ERSETZEN

# EMAIL_USER_TERMIN=termin@anwalt-offenbach.de
# EMAIL_PASSWORD_TERMIN=BITTE_ERSETZEN

# EMAIL_USER_BUSSGELD=bussgeld@anwalt-offenbach.de
# EMAIL_PASSWORD_BUSSGELD=BITTE_ERSETZEN

# EMAIL_USER_INFO=info@anwalt-offenbach.de
# EMAIL_PASSWORD_INFO=BITTE_ERSETZEN

# =============================================================================
#  KI-INTEGRATION  (optional – für KI-gestützte Haftungsbegründung)
# =============================================================================
# Anthropic API-Key für Claude Sonnet (wird nur für den "KI-Vorschlag"-Button
# im Klage-Wizard benötigt). Ohne Key ist der Button deaktiviert.
# Key erstellen: https://console.anthropic.com/settings/keys
#
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...


# =============================================================================
#  LLM-PARSING  (optional – lokales KI-Parsing via LM Studio)
# =============================================================================
# Voraussetzung: LM Studio lokal installiert + Modell geladen
# LM Studio Download: https://lmstudio.ai
#
# Innerhalb Docker → host.docker.internal:1234 statt localhost:1234
# LLM_BASE_URL=http://host.docker.internal:1234/v1
#
# LLM_MODEL      – Standard-Modell beim Start (muss in LM Studio geladen sein)
# LLM_MODELS     – Komma-getrennte Liste aller Modelle die per UI wählbar sein sollen
# LLM_ENABLED=false
# LLM_TIMEOUT=60
#
# LLM_MODEL=qwen3.5-9b
# LLM_MODELS=qwen3.5-9b,mistral-7b-instruct-v0.3,llama-3.2-3b-instruct


# =============================================================================
#  RA-MICRO INTEGRATION  (Modul 8 – Wiedervorlage & Sachstandsanfragen)
# =============================================================================
# Nur-Lese-Zugriff auf RA-Micro SQL Server 2014.
# Voraussetzung: Read-Only SQL-Benutzer im SQL Server Management Studio anlegen.
#
# Aktivierung: RAMICRO_AKTIV auf "true" setzen, sobald alle Daten eingetragen.
# -----------------------------------------------------------------------------

# Verbindung aktivieren (true/false)
RAMICRO_AKTIV=false

# IP-Adresse des Kanzlei-Servers mit SQL Server 2014
# RAMICRO_HOST=192.168.1.x

# SQL Server Port (Standard: 1433)
# RAMICRO_PORT=1433

# Datenbankname in SQL Server (aus sbergebnis: "RAMICRO")
RAMICRO_DATABASE=RAMICRO

# Read-Only SQL-Benutzer (im SQL Server Management Studio anlegen)
# RAMICRO_USER=unfallakten_ro2

# Passwort des Read-Only-Benutzers
# RAMICRO_PASSWORD=BITTE_ERSETZEN

# Verbindungstimeout in Sekunden
RAMICRO_TIMEOUT=10


# =============================================================================
#  PORTAL-SYNC  (Workstream B – Stakeholder-Portal)
# =============================================================================
# Verbindung zum Mandanten-Stakeholder-Portal (portal.anwalt-offenbach.de).
# Aktivierung: PORTAL_API_URL einkommentieren und Werte eintragen.
#
# PORTAL_API_URL  – Basis-URL des Portals (kein abschliessender Slash)
# PORTAL_API_KEY  – API-Key des Portals (wird als Bearer-Token gesendet)
# PORTAL_HMAC_SECRET – Geheimnis fuer HMAC-Signatur der Webhook-Payloads
#                      (mindestens 32 Zeichen, zufaellig generiert)
#
# Secret generieren mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------

# Aktivieren wenn portal.anwalt-offenbach.de deployed ist:
# PORTAL_API_URL=https://portal.anwalt-offenbach.de
# PORTAL_API_KEY=your-portal-api-key-here
# PORTAL_HMAC_SECRET=your-hmac-secret-at-least-32-chars
